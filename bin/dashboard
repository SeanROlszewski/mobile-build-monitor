#!/bin/sh
# Start the Mobile Build Monitor dashboard (default port 8484).
# Resolves through symlinks so it can be invoked from anywhere
# (e.g. a symlink in ~/.mobile-build-monitor/bin).
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
exec python3 "$(dirname "$SELF")/../dashboard/server.py" "$@"
