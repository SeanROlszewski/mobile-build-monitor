#!/bin/sh
# Start the Mobile Build Monitor dashboard (default port 8484).
# Resolves through symlinks so it can be invoked from anywhere
# (e.g. a symlink in ~/.mobile-build-monitor/bin). macOS readlink does not
# support GNU readlink's -f flag, so resolve links one at a time.
SELF=$0
while [ -L "$SELF" ]; do
  LINK_DIR=$(cd -P "$(dirname "$SELF")" && pwd)
  LINK_TARGET=$(readlink "$SELF")
  case $LINK_TARGET in
    /*) SELF=$LINK_TARGET ;;
    *) SELF=$LINK_DIR/$LINK_TARGET ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SELF")" && pwd)
exec python3 "$SCRIPT_DIR/../dashboard/server.py" "$@"
